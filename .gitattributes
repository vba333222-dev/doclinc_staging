# Line endings
#
# The application is checked out on Linux in CI and on Windows for local work.
# Keep text files LF in both places so source comparisons are machine
# independent — several contract tests compare multi-line source literals and
# would otherwise pass in CI and fail locally.
* text=auto eol=lf

# Vendored third-party bundles are integrity checked against pinned SHA-256
# digests. They must never be line-ending converted, or the checksum verifies a
# normalised copy instead of the published artefact.
assets/vendor/** -text
# Sama untuk pustaka yang disajikan panel admin sendiri: leaflet.css dikirim
# upstream dengan CRLF, dan PROVENANCE.md mencatat SHA-256 berkas apa adanya.
admin_menu/assets/vendor/** -text

# Batas kecamatan juga diperiksa terhadap SHA-256 yang dicatat di
# assets/geojson/PROVENANCE.md, jadi berkasnya tidak boleh dinormalkan git.
admin_menu/assets/geojson/** -text

