# Local database dumps / seeds
assets/*.sql

vendor/
!assets/vendor/
!assets/vendor/centrifuge/
!assets/vendor/centrifuge/5.7.0/
!assets/vendor/centrifuge/5.7.0/centrifuge.js
!assets/vendor/centrifuge/5.7.0/LICENSE
!assets/vendor/centrifuge/5.7.0/PROVENANCE.md
# Leaflet dipakai panel admin untuk peta sebaran penyakit, dan panel harus tetap
# utuh di jaringan Puskesmas yang tidak punya internet. Karena itu pustakanya
# ikut repositori - dengan lisensi dan catatan asalnya, seperti centrifuge.
#
# Git tidak bisa memasukkan berkas yang direktori induknya diabaikan, jadi
# `vendor/` harus dibuka lebih dulu, lalu isinya diabaikan lagi satu per satu:
# yang lama tetap terlacak seperti sebelumnya (aturan abaikan hanya berlaku
# untuk berkas yang BELUM terlacak), dan yang dibuka hanya folder Leaflet.
!admin_menu/assets/vendor/
admin_menu/assets/vendor/*
!admin_menu/assets/vendor/leaflet/
!admin_menu/assets/vendor/leaflet/leaflet.js
!admin_menu/assets/vendor/leaflet/leaflet.css
!admin_menu/assets/vendor/leaflet/LICENSE
!admin_menu/assets/vendor/leaflet/PROVENANCE.md
node_modules/

.DS_Store

application/third_party/firebase/*firebase-adminsdk*.json
*firebase-adminsdk*.json

.env

# Documentation stays out of the repository
*.md
*.txt

# Files the application, its tests, or third-party licences require
!assets/vendor/centrifuge/5.7.0/PROVENANCE.md
!admin_menu/assets/vendor/leaflet/LICENSE
!admin_menu/assets/vendor/leaflet/PROVENANCE.md
!admin_menu/assets/geojson/PROVENANCE.md
!license.txt
!admin_menu/license.txt
!database/master_data/clinical/v1/SHA256SUMS.txt
!tools/personal_nakes/staging_readonly_inventory.sql.txt
!admin_menu/application/third_party/vendor_2/mpdf/mpdf/**/*.txt

# ReStructuredText documentation
*.rst

# Local agent tooling. These directories hold editor/assistant skill definitions
# used while developing. They are not part of the application and nothing at
# runtime reads them.
.claude/
.codebuddy/
.codex/
.commandcode/
.cursor/
.gemini/
.junie/
agent/
skills-lock.json

# UI reference material and exported design assets. Kept locally for design work.
docs/

# Local test harnesses and fixture seeders.
# devseed_cli.php inserts sample rows; it must never be run against a database
# that holds real data, so it is kept out of the repository entirely.
devseed_cli.php
_seed_dummy_doctor.php
tools/task11_browser/pw_*.config.js

# Deployment runbooks and the SQL they reference must ship with the repository.
# These re-inclusions are needed because of the broad *.md / *.txt / *.sql rules
# above; gitignore negation works here because the deploy/ directory itself is
# not excluded.
!deploy/*.md
!deploy/**/*.md
!deploy/*.txt
!deploy/**/*.sql
